APP_NAME=Jarumba Music API
APP_VERSION=0.1.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Verifies Supabase access tokens (JWT signature). NEVER ship
# this to the mobile app or expose it in any client-facing response.
SUPABASE_JWT_SECRET=
# Explicit target for the opt-in live RLS verification tests ONLY. The test
# suite NEVER falls back to DATABASE_URL for this. Leave empty for normal
# development; set by hand only for a controlled verification run.
JARUMBA_LIVE_DATABASE_URL=
JAMENDO_CLIENT_ID=
